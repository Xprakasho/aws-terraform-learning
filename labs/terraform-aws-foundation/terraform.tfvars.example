

aws_region    = "us-east-1"
aws_profile   = "your-aws-profile"

instances = {
  web = {
    instance_type = "t3.micro"
    monitoring    = false
    environment   = "dev"
  }

  app = {
    instance_type = "t3.micro"
    monitoring    = false
    environment   = "dev"
  }

  db = {
    instance_type = "t3.small"
    monitoring    = false
    environment   = "dev"
  }
}


ingress_rules = [
  {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  },
  {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  },
  {
    description = "HTTPS"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
]
